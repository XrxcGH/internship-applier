# Copy to .env for local development. Never commit .env.
#
# API keys stay in this file. There is nowhere else for them to go: the header here used
# to say they move to the OS keychain in production via POST /api/settings/keys, and that
# endpoint has never existed — docs/10-security-privacy.md lists it under "Not built", and
# the keychain holds the field-encryption key and nothing else. It also promised a warning
# on startup when .env is used; there is none, and a successful load is silent. Anyone who
# read this file as written believed the plaintext key they were pasting in was temporary.
# It is permanent, and it is as protected as this file's own permissions.

NODE_ENV=development
LOG_LEVEL=debug

# Local API server
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# Web dev server (Vite)
WEB_PORT=5173

# The single root for everything this app writes: the database, resumes, artifacts, the
# browser profile and the master key. Move this one line to move all of them together —
# onto an encrypted volume, for instance.
# DATA_DIR=./data

# SQLite location, relative to the repo root. Leave it unset unless the database must live
# somewhere other than DATA_DIR: setting it pins the database to the repo root while
# everything else follows DATA_DIR, which is how `npm test` once wiped a real data
# directory and how moving DATA_DIR to an encrypted volume would leave every posting,
# answer and application behind on the unencrypted disk with the key on the encrypted one.
# It shipped uncommented here, so every copied config had that split built in.
# DATABASE_PATH=./data/app.db

# --- Model access — see docs/14-model-access.md ---
#
# auto        use the Claude Code CLI if installed, else an API key, else no model
# claude_cli  run your own `claude` binary; your subscription, no API billing
# api         ANTHROPIC_API_KEY, billed per token
# none        refuse model calls
#
# Only resume reading and answer drafting need a model. Matching, eligibility,
# fact-checking, and the writing checks all run without one.
LLM_PROVIDER=auto

# Set only if `claude` is not on PATH.
# CLAUDE_CLI_PATH=C:\Users\you\.local\bin\claude.exe
# CLAUDE_CLI_TIMEOUT_MS=180000

# Only needed when LLM_PROVIDER is `api`.
# ANTHROPIC_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=
# BRAVE_SEARCH_API_KEY=
