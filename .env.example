# Copy to .env for local development. Never commit .env.
#
# In production these move to the OS keychain via POST /api/settings/keys
# (see docs/10-security-privacy.md). The .env path is dev-only and the server
# logs a warning when it is used.

NODE_ENV=development
LOG_LEVEL=debug

# Local API server
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# Web dev server (Vite)
WEB_PORT=5173

# SQLite location, relative to the repo root
DATABASE_PATH=./data/app.db

# --- Not used until M1 ---
# ANTHROPIC_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=
# BRAVE_SEARCH_API_KEY=
