# Copy to .env for local development. Never commit .env.
#
# In production these move to the OS keychain via POST /api/settings/keys
# (see docs/10-security-privacy.md). The .env path is dev-only and the server
# logs a warning when it is used.

NODE_ENV=development
LOG_LEVEL=debug

# Local API server
SERVER_HOST=127.0.0.1
SERVER_PORT=8787

# Web dev server (Vite)
WEB_PORT=5173

# SQLite location, relative to the repo root
DATABASE_PATH=./data/app.db

# --- Model access — see docs/14-model-access.md ---
#
# auto        use the Claude Code CLI if installed, else an API key, else no model
# claude_cli  run your own `claude` binary; your subscription, no API billing
# api         ANTHROPIC_API_KEY, billed per token
# none        refuse model calls
#
# Only resume reading and answer drafting need a model. Matching, eligibility,
# fact-checking, and the writing checks all run without one.
LLM_PROVIDER=auto

# Set only if `claude` is not on PATH.
# CLAUDE_CLI_PATH=C:\Users\you\.local\bin\claude.exe
# CLAUDE_CLI_TIMEOUT_MS=180000

# Only needed when LLM_PROVIDER is `api`.
# ANTHROPIC_API_KEY=
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=
# BRAVE_SEARCH_API_KEY=
