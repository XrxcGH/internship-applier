# Normalize line endings so Windows checkouts don't churn the whole tree.
* text=auto eol=lf

# Shell scripts must stay LF or they won't execute.
*.sh text eol=lf
.githooks/* text eol=lf

# Generated — don't diff, don't count toward language stats.
package-lock.json linguist-generated=true -diff
apps/server/drizzle/**   linguist-generated=true

# Binary
*.pdf binary
*.docx binary
*.png binary
*.jpg binary
